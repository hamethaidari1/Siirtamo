# ==============================================================================
# Server-side cPanel SMTP Configuration for info@siirtamo.fi
# (Never commit real values or expose in frontend code)
# ==============================================================================
# In cPanel -> Email Accounts -> "Connect Devices" / "Mail Client Manual Settings":
# Hostname: Usually mail.siirtamo.fi or your cPanel server's hostname (e.g. serverXXX.yourhosting.fi)
SMTP_HOST=mail.siirtamo.fi

# Port: 465 (SSL/TLS - recommended) or 587 (STARTTLS)
SMTP_PORT=465

# Set to true for Port 465, or false for Port 587
SMTP_SECURE=true

# Username: Full email address
SMTP_USER=info@siirtamo.fi

# Password: The password configured for info@siirtamo.fi in cPanel
SMTP_PASS=your_cpanel_email_password_here

# Notification recipient and sender name
NOTIFICATION_EMAIL=info@siirtamo.fi
SMTP_FROM="Siirtamo Siivouspalvelut" <info@siirtamo.fi>

# Optional: Set to "true" only if testing with self-signed SSL certificates on cPanel
SMTP_ALLOW_INVALID_CERTS=false
